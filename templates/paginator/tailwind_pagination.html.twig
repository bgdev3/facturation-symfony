{% if pageCount > 1 %}
<nav class="flex justify-center mt-6">
    <ul class="flex items-center gap-2">

        {# Bouton précédent #}
        {% if current > 1 %}
            <li>
                <a href="{{ path(route, query|merge({(pageParameterName): (current - 1)})) }}"
                   class="flex items-center justify-center min-w-[44px] h-11 px-3 rounded-md text-base text-gray-400 border border-gray-200 hover:bg-gray-100 hover:text-gray-600 transition-colors">
                    &lt;
                </a>
            </li>
        {% endif %}

        {# Numéros de page #}
        {% for page in pagesInRange %}
            <li>
                {% if page == current %}
                    <span class="flex items-center justify-center min-w-[44px] h-11 px-3 rounded-md text-base font-semibold bg-blue-500 text-white">
                        {{ page }}
                    </span>
                {% else %}
                    <a href="{{ path(route, query|merge({(pageParameterName): page})) }}"
                       class="flex items-center justify-center min-w-[44px] h-11 px-3 rounded-md text-base font-medium text-gray-600 border border-gray-200 hover:bg-gray-100 transition-colors">
                        {{ page }}
                    </a>
                {% endif %}
            </li>
        {% endfor %}

        {# Bouton suivant #}
        {% if current < pageCount %}
            <li>
                <a href="{{ path(route, query|merge({(pageParameterName): (current + 1)})) }}"
                   class="flex items-center justify-center min-w-[44px] h-11 px-3 rounded-md text-base text-gray-400 border border-gray-200 hover:bg-gray-100 hover:text-gray-600 transition-colors">
                    &gt;
                </a>
            </li>
        {% endif %}

        {# Bouton dernière page #}
        {% if current < pageCount %}
            <li>
                <a href="{{ path(route, query|merge({(pageParameterName): pageCount})) }}"
                   class="flex items-center justify-center min-w-[44px] h-11 px-3 rounded-md text-base text-gray-400 border border-gray-200 hover:bg-gray-100 hover:text-gray-600 transition-colors">
                    &gt;&gt;
                </a>
            </li>
        {% endif %}

    </ul>
</nav>
{% endif %}