{% use 'form_div_layout.html.twig' %}

{% block form_row %}
    <div class="mb-4">
        {{ form_label(form) }}
        {{ form_widget(form) }}
        {{ form_errors(form) }}
        {{ form_help(form) }}
    </div>
{% endblock %}

{% block form_label %}
    <label {% if label_attr %}{% with { attr: label_attr } %}{% endwith %}{% endif %} class="block text-sm font-medium text-gray-700 mb-1">
        {{ label|trans(label_translation_parameters, translation_domain) }}
    </label>
{% endblock %}

{% block form_widget_simple %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' w-full rounded bg-white border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <ul class="mt-1 text-sm text-red-600 space-y-0.5">
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}

{% block checkbox_row %}
    <div class="mb-4 flex items-center gap-2">
        {{ form_widget(form) }}
        {{ form_label(form, null, {label_attr: {class: 'text-sm font-medium text-gray-700 mb-0'}}) }}
    </div>
    {{ form_errors(form) }}
{% endblock %}

{% block checkbox_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block button_widget %}
    {% set attr = attr|merge({class: (attr.class|default('') ~ ' block mx-auto w-48 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 rounded transition-colors')|trim}) %}
    {{ parent() }}
{% endblock %}