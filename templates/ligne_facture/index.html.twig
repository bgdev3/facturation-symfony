{% extends 'base.html.twig' %}

{% block title %}LigneFacture index{% endblock %}

{% block body %}
    <h1>LigneFacture index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Designation</th>
                <th>Quantite</th>
                <th>PrixUnitaireHT</th>
                <th>TauxTVA</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ligneFacture in ligneFactures %}
            <tr>
                <td>{{ ligneFacture.id }}</td>
                <td>{{  ligneFacture.designation }}</td>
                <td>{{  ligneFacture.quantite }}</td>
                <td>{{  ligneFacture.prixUnitaireHT }}</td>
                <td>{{  ligneFacture.tauxTVA }}</td>
                <td>
                    <a href="{{ path('ligneFacture.show', {'id': ligneFacture.id}) }}">show</a>
                    <a href="{{ path('ligneFacture.edit', {'id': ligneFacture.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('ligneFacture.new') }}">Create new</a>
{% endblock %}
