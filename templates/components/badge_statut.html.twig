{# templates/components/_badge_statut.html.twig #}
{% set badgeClasses = {
    'gray':   'bg-gray-100 text-gray-800',
    'blue':   'bg-blue-100 text-blue-800',
    'green':  'bg-green-100 text-green-800',
    'red':    'bg-red-100 text-red-800',
    'orange': 'bg-orange-100 text-orange-800',
} %}
<span class="inline-block px-2.5 py-1 text-xs font-bold {{ badgeClasses[statut.badgeColor] }}">
    {{ statut.label }}
</span>