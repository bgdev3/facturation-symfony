{% for type, messages in app.flashes %}
    <div class="rounded-lg p-4 mb-2 text-sm font-medium animate-fade-out
        {% if type == 'success' %} bg-green-50 text-green-800
        {% elseif type in ['error', 'danger'] %} bg-red-50 text-red-800
        {% elseif type == 'warning' %} bg-yellow-50 text-yellow-800
        {% else %} bg-blue-50 text-blue-800
        {% endif %}">
        {{ messages|join('. ') }}
    </div>
{% endfor %}