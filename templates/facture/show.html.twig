{% extends 'base.html.twig' %}

{% block title %}Facture{% endblock %}

{% block body %}
    <h1>Facture</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ facture.id }}</td>
            </tr>
            <tr>
                <th>Numero</th>
                <td>{{ facture.numero }}</td>
            </tr>
            <tr>
                <th>DeteEmission</th>
                <td>{{ facture.deteEmission ? facture.deteEmission|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateEcheance</th>
                <td>{{ facture.dateEcheance ? facture.dateEcheance|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ facture.statut }}</td>
            </tr>
            <tr>
                <th>MontantHT</th>
                <td>{{ facture.montantHT }}</td>
            </tr>
            <tr>
                <th>MontantTVA</th>
                <td>{{ facture.montantTVA }}</td>
            </tr>
            <tr>
                <th>MontantTTC</th>
                <td>{{ facture.montantTTC }}</td>
            </tr>
            <tr>
                <th>ConditionsPaiment</th>
                <td>{{ facture.conditionsPaiment }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('facture.index') }}">back to list</a>

    <a href="{{ path('facture.edit', {'id': facture.id}) }}">edit</a>

    {{ include('facture/_delete_form.html.twig') }}
{% endblock %}
