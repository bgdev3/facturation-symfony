{% extends 'base.html.twig' %}

{% block title %}Facture{% endblock %}

{% block body %}

<div class="max-w-xl mx-auto flex flex-col lg:flex-row justify-center gap-6 px-4 mt-5">

     <!-- Facture : colonne principale, large -->
     <div class="w-full lg:w-1/4 bg-gray-50 p-2 rounded-lg ">
        <!-- En-tête -->
        <header class="flex justify-between items-start border-b-2 border-text-dark pb-6 mb-8">
            <!-- Émetteur -->
            <div class="emetteur">
            <div class="logo text-xl font-bold text-primary-blue mb-2">{{ app.user.company.logo }}</div>
            <p class="text-xs text-text-medium">
                <strong>{{ app.user.company.name }}</strong><br>
                {{ app.user.company.address }}<br>
                {{ app.user.company.postalCode }} {{ app.user.company.city }}<br>
                SIRET : {{ app.user.company.siret }}
            </p>
            </div>

            <!-- Titre + Infos facture -->
            <div class="titre-bloc text-right">
            <h1 class="text-2xl font-bold tracking-widest mb-4 text-text-dark">FACTURE</h1>
            <table class="infos-facture text-xs ml-auto">
                <tr>
                <td class="text-text-light pr-0">N°&nbsp;</td>
                <td class="font-semibold text-text-dark pl-4"> {{ facture.numero }}</td>
                </tr>
                <tr>
                <td class="text-text-light pr-0">Date d'émission</td>
                <td class="font-semibold text-text-dark pl-4">{{ facture.dateEmission ? facture.dateEmission|date('d/m/Y') : '' }}</td>
                </tr>
                <tr>
                <td class="text-text-light pr-0">Date d'échéance</td>
                <td class="font-semibold text-text-dark pl-4">{{ facture.dateEcheance ? facture.dateEcheance|date('d/m/Y') : '' }}</td>
                </tr>
                <tr>
                <td class="text-text-light pr-0">Statut</td>
                <td class="font-semibold text-text-dark pl-4">{{ facture.statut.value }}</td>
                </tr>
            </table>
            </div>
        </header>

        <!-- Tableau des lignes -->
        <table class="lignes w-full border-collapse mb-6">
            <thead>
            <tr>
                <th class="col-desc text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Description</th>
                <th class="col-qte text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Qté</th>
                <th class="col-pu text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Prix unitaire HT</th>
                <th class="col-total text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Total</th>
            </tr>
            </thead>
            <tbody>
            {% for ligne in facture.ligneFactures %}
            <tr>
                <td class="py-3 px-3 border-b border-border-light">{{ ligne.designation }}</td>
                <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap">{{ ligne.quantite }}</td>
                <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap">{{ ligne.prixUnitaireHT|number_format(2, ',', ' ') }}&nbsp;€</td>
                <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap">{{ ligne.total|number_format(2, ',', ' ') }}&nbsp;€</td>
            </tr>
            {% endfor %}
            <tr>
                <td colspan="4" class="border-b-2 border-text-dark"></td>
            </tr>
            </tbody>
        </table>

        <!-- Totaux -->
        <section class="totaux flex justify-end mb-10">
            <table class="min-w-[260px] border-collapse">
            <tbody>
                <tr>
                <td class="py-1.5 text-text-medium">Montant HT</td>
                <td class="py-1.5 text-right font-medium">{{ facture.montantHT|number_format(2, ',', ' ') }}&nbsp;€</td>
                </tr>
                <tr>
                <td class="py-1.5 text-text-medium">TVA</td>
                <td class="py-1.5 text-right font-medium">{{ facture.montantTVA|number_format(2, ',', ' ') }}&nbsp;€</td>
                </tr>
                <tr class="total-final">
                <td class="py-2.5 text-text-dark font-bold text-base">Total TTC</td>
                <td class="py-2.5 text-right text-primary-blue font-bold text-xl">{{ facture.montantTTC|number_format(2, ',', ' ') }}&nbsp;€</td>
                </tr>
                <tr>
                <td class="py-1.5 text-text-medium">Total payé</td>
                <td class="py-1.5 text-right font-medium">{{ facture.totalPaye|number_format(2, ',', ' ') }}&nbsp;€</td>
                </tr>
                <tr>
                <td class="py-1.5 text-text-dark font-semibold">Reste à payer</td>
                <td class="py-1.5 text-right font-semibold">{{ facture.resteAPayer|number_format(2, ',', ' ') }}&nbsp;€</td>
                </tr>
            </tbody>
            </table>
        </section>

        <!-- Conditions -->
        <section class="mb-6 text-xs text-medium">
            <strong>Conditions de paiement :</strong> {{ facture.conditionsPaiement }}
        </section>
    </div>

    <!-- Paiements : colonne latérale, étroite -->
    <div class="w-full lg:w-3/4 bg-white p-4 rounded-lg shadow-md overflow-auto max-h-[calc(100vh-200px)]">
        {{ include('facture/show_split.html.twig') }}
    </div>

</div>

<!-- Actions -->
<div class="max-w-xl mx-auto flex flex-col lg:flex-row justify-center gap-6 px-4 mt-5">
  <a href="{{ path('facture.index') }}" class="inline-block px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark text-xs hover:bg-green-100 transition-colors">Retour</a>

  {{ include('facture/_delete_form.html.twig', {'facture': facture}) }}

  <a href="{{ path('facture.edit', {'id': facture.id}) }}" class="inline-block w-50 px-2.5 py-1.5 bg-yellow-300 text-dark text-xs rounded-md hover:bg-yellow-100 transition-colors">Modifier</a>
</div>

{% endblock %}