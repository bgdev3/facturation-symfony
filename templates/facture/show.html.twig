{% extends 'base.html.twig' %}

{% block title %}Facture{% endblock %}

{% block body %}

<div class="max-w-full mx-auto flex flex-col lg:flex-row justify-center gap-6 px-4 mt-5">

     <!-- Facture : colonne principale, large -->
     <div class="w-full lg:w-1/2 bg-gray-50 p-2 rounded-lg ">
        <!-- En-tête -->
        <header class="flex justify-between items-start border-b-2 border-text-dark pb-6 mb-8">
            <!-- Émetteur -->
            <div class="emetteur">
            <div class="logo text-xl font-bold text-primary-blue mb-2">{{ app.user.company.logo }}</div>
            <p class="text-xs text-text-medium">
                <strong>{{ app.user.company.name }}</strong><br>
                {{ app.user.company.address }}<br>
                {{ app.user.company.postalCode }} {{ app.user.company.city }}<br>
                SIRET : {{ app.user.company.siret }}
            </p>
            </div>

            <!-- Titre + Infos facture -->
            <div class="titre-bloc text-right">
                <h1 class="text-2xl font-bold tracking-widest mb-4 text-text-dark">FACTURE</h1>
                <table class="infos-facture text-xs ml-auto">

                    {% set colonnes = {
                        'N°&nbsp;' : facture.numero,
                        'Date d\'émission' : facture.dateEmission ? facture.dateEmission|date('d/m/Y') : '' ,
                        'Date d\'échéance' :  facture.dateEcheance ? facture.dateEcheance|date('d/m/Y') : '',
                        'Statut' :  facture.statut.value }
                    %}

                    {% for label, value in colonnes %}
                        <tr>
                            <td class="text-text-light pr-0">{{ label | raw}}</td>
                            <td class="font-semibold text-text-dark pl-4"> {{ value }}</td>
                        </tr>
                    {% endfor%}
                </table>
            </div>
        </header>

        <!-- Tableau des lignes -->
        <table class="lignes w-full border-collapse mb-6">
            <thead>
                {% set colonnes = [
                    'Description',
                    'Qté',
                    'Prix unitaire HT',
                    'Total'] 
                %}

                <tr>
                    {% for colonne in  colonnes %}
                        <th class="col-desc text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3"> {{ colonne }}</th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>
                {% for ligne in facture.ligneFactures %}

                    {% set colonnes = [
                        {value : ligne.designation, numeric : false },
                        {value : ligne.quantite, numeric  :false},
                        { value : ligne.prixUnitaireHT|number_format(2, ',', ' '), numeric :true},
                        { value : ligne.total|number_format(2, ',', ' '), numeric : true}] 
                    %}

                    <tr>
                        {% for colonne in  colonnes %}
                            <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap"> {{ colonne.value}}
                                {% if colonne.numeric %} &nbsp;€  {%endif%} 
                            </td>
                         {% endfor %}
                    </tr>

                {% endfor %}
                <!-- Bordures -->
                <tr>
                    <td colspan="4" class="border-b-2 border-text-dark"></td>
                </tr>
            </tbody>
        </table>

        <!-- Totaux -->
        <section class="totaux flex justify-end mb-10">
            <table class="min-w-[260px] border-collapse">
            <tbody>
                {% set colonnes = [
                        {label: 'Montant HT', value : facture.montantHT|number_format(2, ',', ' '), class:'"py-1.5 text-text-medium', valueClass: 'py-1.5 text-right font-medium'},
                        {label: 'TVA', value : facture.montantTVA|number_format(2, ',', ' '), class: 'py-1.5 text-text-medium', valueClass:'py-1.5 text-right font-medium'},
                        {label: 'Total TTC', value :  facture.montantTTC|number_format(2, ',', ' '), class : 'py-2.5 text-text-dark font-bold text-base', valueClass:'py-2.5 text-right text-primary-blue font-bold text-xl', trClass:'total-final'},
                        {label : 'Total payé', value :  facture.totalPaye|number_format(2, ',', ' '), class :'py-1.5 text-text-medium', valueClass :'py-1.5 text-right font-medium'},
                        {label: 'Reste à payer', value : facture.resteAPayer|number_format(2, ',', ' '), class : 'py-1.5 text-text-dark font-semibold', valueClass:'py-1.5 text-right font-semibold'}]
                    %}

                {% for colonne in  colonnes %}
                <tr class=" {{ colonne.trClass|default('') }} ">
                    <td class=" {{ colonne.class }}"> {{ colonne.label}}</td>
                    <td class=" {{ colonne.valueClass }}">{{ colonne.value }}&nbsp;€</td>
                </tr>
                {% endfor %}
              
            </tbody>
            </table>
        </section>

        <!-- Conditions -->
        <section class="mb-6 text-xs text-medium">
            <strong>Conditions de paiement :</strong> {{  facture.conditionsPaiement.label ? facture.conditionsPaiement.label : ''}}
        </section>
    </div>

    <!-- Paiements : colonne latérale, étroite -->
    <div class="w-full lg:w-1/2 bg-white p-4 rounded-lg shadow-md overflow-auto max-h-[calc(100vh-200px)]">
        {{ include('facture/show_split.html.twig') }}
    </div>

</div>

<!-- Actions -->
<div class="max-w-xl mx-auto flex flex-col lg:flex-row justify-center gap-6 px-4 mt-5">
    <a href="{{ path('facture.index') }}" class="inline-block px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark text-xs hover:bg-green-100 transition-colors">
        <!-- Icone 'RETOUR' -->
         <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M7.793 2.232a.75.75 0 0 1-.025 1.06L3.622 7.25h10.003a5.375 5.375 0 0 1 0 10.75H10.75a.75.75 0 0 1 0-1.5h2.875a3.875 3.875 0 0 0 0-7.75H3.622l4.146 3.957a.75.75 0 0 1-1.036 1.085l-5.5-5.25a.75.75 0 0 1 0-1.085l5.5-5.25a.75.75 0 0 1 1.06.025Z" clip-rule="evenodd" />
            </svg>
    </a>

    {{ include('facture/delete_form.html.twig', {'facture': facture}) }}
   
    <!-- Relance la facture -->
        {% if is_granted('INVOICE_RELANCE', facture) %}
            <form action="{{ path('facture.relancer', {'id': facture.id}) }}" method="post">
                <button type="submit"
                        name="_token"
                        value="{{ csrf_token('relance' ~ facture.id) }}"
                        onclick="return confirm('Envoyer une relance à {{ facture.client.email }} ?')"
                        class="inline-flex shrink-0 items-center justify-center w-28 px-3 py-1.5 text-xs font-semibold
                            rounded-md bg-blue-100 text-blue-800 hover:bg-blue-200 transition-colors">
                                    <!-- Icone 'RELANCER' -->
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                            <path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z" clip-rule="evenodd" />
                        </svg>
                </button>
            </form>
        {% endif %}

   {% if is_granted('INVOICE_EDIT', facture) %}
            <a href="{{ path('facture.edit', {'id': facture.id}) }}" class="inline-block px-2.5 py-1.5 text-center bg-yellow-300 rounded-md text-dark text-xs hover:bg-yellow-100 transition-colors">
                <!-- icone 'MODIFIER' -->
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                    <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                    <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
                </svg>
            </a>
                        
    {% endif %}
</div>

{% endblock %}