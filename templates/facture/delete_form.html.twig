{% if is_granted('INVOICE_DELETE', facture) %}
    <form action="{{ path('facture.delete', {'id': facture.id}) }}" method="post">
        <button type="submit"
                name="_token"
                value="{{ csrf_token('delete' ~ facture.id) }}"
                onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette facture ?')"
                class="inline-flex shrink-0 items-center justify-center w-28 px-3 py-1.5 text-xs font-semibold
                       rounded-md bg-red-100 text-red-800 hover:bg-red-200 transition-colors">
            Supprimer
        </button>
    </form>
{% endif %}