<!-- Paiements -->
{% if facture.paiements|length > 0 %}
<section class="mb-10 bg-gray-50">
    <h2 class="text-sm text-center font-bold mb-3 text-text-dark">Paiements enregistrés</h2>
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <th class="text-left text-xs uppercase tracking-wider text-text-light py-2 border-b border-border-light">Date</th>
          <th class="text-left text-xs uppercase tracking-wider text-text-light py-2 border-b border-border-light">Montant</th>
          <th class="text-left text-xs uppercase tracking-wider text-text-light py-2 border-b border-border-light">Moyen</th>
          <th class="border-b border-border-light print:hidden"></th>
        </tr>
      </thead>
      <tbody>
        {% for paiement in facture.paiements %}
        <tr>
          <td class=" text-xs py-2 border-b border-border-light">{{ paiement.date|date('d/m/Y') }}</td>
          <td class="text-xs py-2 border-b border-border-light">{{ paiement.montant|number_format(2, ',', ' ') }}&nbsp;€</td>
          <td class="text-xs py-2 border-b border-border-light">{{ paiement.moyen.value }}</td>
          <td class="text-xs py-2 border-b border-border-light print:hidden">
            <form method="post" action="{{ path('paiement.delete', {id: paiement.id}) }}">
              <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ paiement.id) }}">
              <button type="submit" class="text-xs text-red-600 hover:underline">Supprimer</button>
            </form>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
</section>
{% endif %}

<!-- Ajout d'un paiement -->
<div class="mb-5 print:hidden">
  <h3 class=" text-center font-bold text-sm mt-5 mb-2">Ajouter un paiement</h3>
  {{ form_start(paiementForm, {'action': path('paiement.new', {factureId: facture.id})}) }}
      {{ form_row(paiementForm) }}
      <button type="submit" class="px-2.5 py-1.5 bg-primary-blue text-white text-xs rounded-md hover:opacity-90 transition-colors">Enregistrer le paiement</button>
  {{ form_end(paiementForm) }}
</div>