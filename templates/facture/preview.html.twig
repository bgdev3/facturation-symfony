<div class="max-w-xl mx-auto flex flex-col lg:flex-row justify-center gap-6 px-4 mt-5">

     <!-- Facture : colonne principale, large -->
     <div class="w-full lg:w-1/4 bg-gray-50 p-2 rounded-lg ">
        <!-- En-tête -->
        <header class="flex justify-between items-start border-b-2 border-text-dark pb-6 mb-8">
            <!-- Émetteur -->
            <div class="emetteur">
            <div class="logo text-xl font-bold text-primary-blue mb-2">{{ app.user.company.logo }}</div>
            <p class="text-xs text-text-medium">
                <strong>{{ app.user.company.name }}</strong><br>
                {{ app.user.company.address }}<br>
                {{ app.user.company.postalCode }} {{ app.user.company.city }}<br>
                SIRET : {{ app.user.company.siret }}
            </p>
            </div>

            <!-- Titre + Infos facture -->
            <div class="titre-bloc text-right">
                <h1 class="text-2xl font-bold tracking-widest mb-4 text-text-dark">FACTURE</h1>
                <table class="infos-facture text-xs ml-auto">

                    {% set colonnes = {
                        'N°&nbsp;' : facture.numero,
                        'Date d\'émission' : facture.dateEmission ? facture.dateEmission|date('d/m/Y') : '' ,
                        'Date d\'échéance' :  facture.dateEcheance ? facture.dateEcheance|date('d/m/Y') : '',
                        'Statut' :  facture.statut.value }
                    %}

                    {% for label, value in colonnes %}
                        <tr>
                            <td class="text-text-light pr-0">{{ label | raw}}</td>
                            <td class="font-semibold text-text-dark pl-4"> {{ value }}</td>
                        </tr>
                    {% endfor%}
                </table>
            </div>
        </header>

        <!-- Tableau des lignes -->
        <table class="lignes w-full border-collapse mb-6">
            <thead>
                {% set colonnes = [
                    'Description',
                    'Qté',
                    'Prix unitaire HT',
                    'Total'] 
                %}

                <tr>
                    {% for colonne in  colonnes %}
                        <th class="col-desc text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3"> {{ colonne }}</th>
                    {% endfor %}
                </tr>
            </thead>

            <tbody>
                {% for ligne in facture.ligneFactures %}

                    {% set colonnes = [
                        {value : ligne.designation, numeric : false },
                        {value : ligne.quantite, numeric  :false},
                        { value : ligne.prixUnitaireHT|number_format(2, ',', ' '), numeric :true},
                        { value : ligne.total|number_format(2, ',', ' '), numeric : true}] 
                    %}

                    <tr>
                        {% for colonne in  colonnes %}
                            <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap"> {{ colonne.value}}
                                {% if colonne.numeric %} &nbsp;€  {%endif%} 
                            </td>
                         {% endfor %}
                    </tr>

                {% endfor %}
                <!-- Bordures -->
                <tr>
                    <td colspan="4" class="border-b-2 border-text-dark"></td>
                </tr>
            </tbody>
        </table>

        <!-- Totaux -->
        <section class="totaux flex justify-end mb-10">
            <table class="min-w-[260px] border-collapse">
            <tbody>
                {% set colonnes = [
                        {label: 'Montant HT', value : facture.montantHT|number_format(2, ',', ' '), class:'"py-1.5 text-text-medium', valueClass: 'py-1.5 text-right font-medium'},
                        {label: 'TVA', value : facture.montantTVA|number_format(2, ',', ' '), class: 'py-1.5 text-text-medium', valueClass:'py-1.5 text-right font-medium'},
                        {label: 'Total TTC', value :  facture.montantTTC|number_format(2, ',', ' '), class : 'py-2.5 text-text-dark font-bold text-base', valueClass:'py-2.5 text-right text-primary-blue font-bold text-xl', trClass:'total-final'},
                        {label : 'Total payé', value :  facture.totalPaye|number_format(2, ',', ' '), class :'py-1.5 text-text-medium', valueClass :'py-1.5 text-right font-medium'},
                        {label: 'Reste à payer', value : facture.resteAPayer|number_format(2, ',', ' '), class : 'py-1.5 text-text-dark font-semibold', valueClass:'py-1.5 text-right font-semibold'}]
                    %}

                {% for colonne in  colonnes %}
                <tr class=" {{ colonne.trClass|default('') }} ">
                    <td class=" {{ colonne.class }}"> {{ colonne.label}}</td>
                    <td class=" {{ colonne.valueClass }}">{{ colonne.value }}&nbsp;€</td>
                </tr>
                {% endfor %}
              
            </tbody>
            </table>
        </section>

        <!-- Conditions -->
        <section class="mb-6 text-xs text-medium">
            <strong>Conditions de paiement :</strong> {{ facture.conditionsPaiement }}
        </section>
    </div>

</div>