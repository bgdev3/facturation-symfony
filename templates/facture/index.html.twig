{% extends 'base.html.twig' %}

{% block title %}Facture{% endblock %}

{% block body %}
    <h1 class="text-center font-bold text-xl mt-6">Factures</h1>
    <a href="{{ path('facture.new') }}" class="px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark hover:bg-green-100 transition-colors">Créer facture</a>
    <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mt-6"></div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead>
              
                    {% set colonnes = [
                        'Numero',
                        'Dete Emission', 
                        'Date Echeance',
                        'Montant HT',
                        'Montant TV',
                        'Montant TTC',
                        'Conditions Paiments',
                        'Statut',
                        'actions'
                    ] %}

                {% for colonne in colonnes %}
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-600 bg-gray-100 uppercase tracking-wider">
                        {{ colonne }}
                    </th>
                {% endfor %}

            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for facture in factures %}

                    {% set colonnes = [

                        facture.dateEmission ? facture.dateEmission|date('Y-m-d H:i:s') : '' ,
                        facture.dateEcheance ? facture.dateEcheance|date('Y-m-d H:i:s') : '' ,
                        facture.montantHT ,
                        facture.montantTVA ,
                        facture.montantTTC,
                        facture.conditionsPaiement.label ? facture.conditionsPaiement.label : '' ] 
                    %}

                    <tr class="hover:bg-gray-50 "  id="factureRow_{{ facture.id }}">
                        <th class="px-6 py-2 text-center whitespace-nowrap text-sm bg-gray-100 text-gray-500">
                            <a href=" {{ path('facture.show', {'id': facture.id})}}"> {{ facture.numero }} </a>   
                        </th>
                        {% for colonne in colonnes %}
                            <th class="  {% if is_granted('INVOICE_RELANCE', facture) %}
                            px-6 py-2 text-center whitespace-nowrap bg-red-100 font-medium text-gray-900 
                            {% endif %} px-6 py-2 text-center whitespace-nowrap  font-medium text-gray-900  ">
                                {{ colonne }}
                            </th>
                        {% endfor %}
                    
                        <th class="px-6 py-2 text-center whitespace-nowrap text-sm  uppercase">
                            {{ include('components/badge_statut.html.twig', { statut: facture.statut }) }}
                        </th>
                        <th class="px-1 py-1 text-center whitespace-nowrap text-sm font-medium text-gray-900">
                                            
                            <div class="flex items-center justify-center gap-2">
                                
                                {% if (facture.statut.value == "brouillon") %}
                                    <a href="{{ path('facture.edit', {'id': facture.id}) }}" class="inline-flex items-center justify-center min-w-[5.5rem] px-3 py-1.5 text-xs font-semibold
                         rounded-md bg-yellow-100 text-yellow-800 hover:bg-yellow-200 transition-colors">Modifier</a>
                                {% else %}   
                                    <a href="{{ path('facture.show', {'id': facture.id}) }}" class="inline-flex items-center justify-center w-32 px-3 py-1.5 text-xs font-semibold
                         rounded-md bg-green-100 text-green-800 hover:bg-green-200 transition-colors">Voir</a>
                                {% endif %}

                                 {{ include('facture/delete_form.html.twig', {'facture': facture}) }}
                            
                            </div>
                        </th>
                    </tr>
            {% else %}
                <tr class="text-center">
                    <td colspan="10">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
     {{ knp_pagination_render(factures) }}
{% endblock %}
