{% extends 'base.html.twig' %}

{% block title %}Factures{% endblock %}

{% block body %}
    <h1 class="text-center font-bold text-xl mt-6">Factures</h1>
    <a href="{{ path('facture.new') }}" class="px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark hover:bg-green-100 transition-colors">Créer facture</a>
    <a href="{{ path('facture.export_csv') }}" class="inline-flex items-center justify-center px-3 py-1.5 text-sm font-semibold
        rounded-md bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors">
            Exporter en CSV
    </a>
    <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mt-6"></div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead>
              
                    {% set colonnes = [
                        'Numero',
                        'Dete Emission', 
                        'Date Echeance',
                        'Montant HT',
                        'Montant TV',
                        'Montant TTC',
                        'Conditions Paiments',
                        'Statut',
                        'actions'
                    ] %}

                {% for colonne in colonnes %}
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-600 bg-gray-100 uppercase tracking-wider">
                        {{ colonne }}
                    </th>
                {% endfor %}

            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for facture in factures %}

                    {% set colonnes = [

                        facture.dateEmission ? facture.dateEmission|date('Y-m-d H:i:s') : '' ,
                        facture.dateEcheance ? facture.dateEcheance|date('Y-m-d H:i:s') : '' ,
                        facture.montantHT ,
                        facture.montantTVA ,
                        facture.montantTTC,
                        facture.conditionsPaiement.label ? facture.conditionsPaiement.label : '' ] 
                    %}

                    <tr class="hover:bg-gray-50 "  id="factureRow_{{ facture.id }}">
                        <th class="px-6 py-2 text-center whitespace-nowrap text-sm bg-gray-100 text-gray-500">
                            <a href=" {{ path('facture.show', {'id': facture.id})}}"> {{ facture.numero }} </a>   
                        </th>
                        {% for colonne in colonnes %}
                            <th class="  {% if is_granted('INVOICE_RELANCE', facture) %}
                            px-6 py-2 text-center whitespace-nowrap bg-red-100 font-medium text-gray-900 
                            {% endif %} px-6 py-2 text-center whitespace-nowrap  font-medium text-gray-900  ">
                                {{ colonne }}
                            </th>
                        {% endfor %}
                    
                        <th class="px-6 py-2 text-center whitespace-nowrap text-sm  uppercase">
                            {{ include('components/badge_statut.html.twig', { statut: facture.statut }) }}
                        </th>
                        <th class="px-1 py-1 text-center whitespace-nowrap text-sm font-medium text-gray-900">
                                            
                            <div class="flex items-center justify-center gap-2">
                                
                                {% if (facture.statut.value == "brouillon") %}
                                    <a href="{{ path('facture.edit', {'id': facture.id}) }}" class="inline-flex items-center justify-center min-w-[5.5rem] px-3 py-1.5 text-xs font-semibold
                                             rounded-md bg-yellow-100 text-yellow-800 hover:bg-yellow-200 transition-colors">
                                             <!-- Icone 'MODIFIER' -->
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                            <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                                            <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
                                        </svg>
                                    </a>
                                {% else %}   
                                    <a href="{{ path('facture.show', {'id': facture.id}) }}" class="inline-flex items-center justify-center w-32 px-3 py-1.5 text-xs font-semibold
                                             rounded-md bg-green-100 text-green-800 hover:bg-green-200 transition-colors">
                                                 <!-- Icone 'VOIR' -->
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                            <path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                                            <path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd" />
                                        </svg>
                                    </a>
                                {% endif %}

                                 {{ include('facture/delete_form.html.twig', {'facture': facture}) }}
                            
                            </div>
                        </th>
                    </tr>
            {% else %}
                <tr class="text-center">
                    <td colspan="10">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
     {{ knp_pagination_render(factures) }}
{% endblock %}
