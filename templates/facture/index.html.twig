{% extends 'base.html.twig' %}

{% block title %}Facture{% endblock %}

{% block body %}
    <h1 class="text-center font-bold text-xl mt-6">Factures</h1>
    <a href="{{ path('facture.new') }}" class="px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark hover:bg-green-100 transition-colors">Créer facture</a>
    <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mt-6"></div>
        <table class="min-w-full divide-y divide-gray-200">
            <thead>
              
                    {% set colonnes = [
                        'Numero',
                        'Dete Emission', 
                        'Date Echeance',
                        'Montant HT',
                        'Montant TV',
                        'Montant TTC',
                        'Conditions Paiments',
                        'Statut',
                        'actions'
                    ] %}

                {% for colonne in colonnes %}
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-600 bg-gray-100 uppercase tracking-wider">
                        {{ colonne }}
                    </th>
                {% endfor %}

            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {% for facture in factures %}

                    {% set colonnes = [

                        facture.dateEmission ? facture.dateEmission|date('Y-m-d H:i:s') : '' ,
                        facture.dateEcheance ? facture.dateEcheance|date('Y-m-d H:i:s') : '' ,
                        facture.montantHT ,
                        facture.montantTVA ,
                        facture.montantTTC,
                        facture.conditionsPaiement.label ? facture.conditionsPaiement.label : '' ] 
                    %}

                    <tr class="hover:bg-gray-50 "  id="factureRow_{{ facture.id }}">
                        <th class="px-6 py-2 text-center whitespace-nowrap text-sm bg-gray-100 text-gray-500">
                            <a href=" {{ path('facture.edit', {'id': facture.id})}}"> {{ facture.numero }} </a>   
                        </th>
                        {% for colonne in colonnes %}
                            <th class="px-6 py-2 text-center whitespace-nowrap text-sm font-medium text-gray-900">
                                {{ colonne }}
                            </th>
                        {% endfor %}
                    
                        <th class="px-6 py-2 text-center whitespace-nowrap text-sm font-bold uppercase text-gray-900">
                            {{ include('components/badge_statut.html.twig', { statut: facture.statut }) }}
                        </th>
                        <th class="px-1 py-1 text-center whitespace-nowrap text-sm font-medium text-gray-900">
                                            
                            <div class="flex gap-2 w-full">
                                
                                {% if (facture.statut.value == "brouillon") %}
                                    <a href="{{ path('facture.edit', {'id': facture.id}) }}" class="flex-1 text-center px-1.5 py-1.5 bg-yellow-300 font-bold text-dark text-xs rounded-md hover:bg-yellow-100 transition-colors">Modifier</a>
                                {% else %}   
                                    <a href="{{ path('facture.show', {'id': facture.id}) }}" class="flex-1 text-center px-1.5 py-1.5 bg-green-300 font-bold text-dark text-xs rounded-md hover:bg-green-100 transition-colors">Voir</a>
                                {% endif %}

                                <form action="{{ path('facture.delete', {'id': facture.id}) }}" method="post" class="flex-1">
                                    <button type="submit" 
                                            class="w-full px-2.5 py-1.5 bg-red-300 text-dark text-xs font-bold rounded-md hover:bg-red-100 transition-colors"
                                            name="_token" 
                                            value="{{ csrf_token('delete' ~ facture.id) }}"
                                            onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette recette ?')">
                                        Supprimer
                                    </button>
                                </form>
                            </div>
                        </th>
                    </tr>
            {% else %}
                <tr class="text-center">
                    <td colspan="10">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
     {{ knp_pagination_render(factures) }}
{% endblock %}
