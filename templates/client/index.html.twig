{% extends 'base.html.twig' %}

{% block title %}Hello ClientController!{% endblock %}

{% block body %}
<h1 class="text-center font-bold text-xl mt-6">Liste clients</h1>
 
<a href=" {{ path('client.create') }}" class="px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark hover:bg-green-100 transition-colors">Ajouter un client</a>
<div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mt-6">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
             {% set colonnes = [
                'Nom',
                'Email',
                'Ville',
                'actions'
                ] %}
            <tr>
                  {% for colonne in colonnes %}
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider ">
                        {{ colonne }}
                    </th>
                {% endfor %} 
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for client in clients %}
            {% set colonnes = [
                client.name,
                client.email,
                client.city,
                ] %}
                <tr class="hover:bg-gray-50">
                    {% for colonne in colonnes %}
                        <th class="px-6 py-2 text-center whitespace-nowrap text-sm font-medium text-gray-900">
                            {{ colonne }}
                        </th>
                     {% endfor %} 
                  
                    <td class="flex justify-center gap-2 py-2 text-center whitespace-nowrap text-right text-sm font-medium">
                        <a href=" {{ path('client.show', {'id':client.id})}}" class="inline-block px-2.5 py-1.5  text-dark text-xs font-bold rounded-md  bg-green-100 text-green-800 hover:bg-green-200 transition-colors ">
                             <!-- Icone 'VOIR' -->
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                <path d="M10 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z" />
                                <path fill-rule="evenodd" d="M.664 10.59a1.651 1.651 0 0 1 0-1.186A10.004 10.004 0 0 1 10 3c4.257 0 7.893 2.66 9.336 6.41.147.381.146.804 0 1.186A10.004 10.004 0 0 1 10 17c-4.257 0-7.893-2.66-9.336-6.41ZM14 10a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z" clip-rule="evenodd" />
                            </svg>
                        </a>

                        <a href=" {{ path('client.edit', {'id':client.id})}}" class="inline-block px-2.5 py-1.5  text-dark text-xs font-bold rounded-md bg-yellow-100 text-yellow-800 hover:bg-yellow-200 transition-colors">
                              <!-- Icone 'MODIFIER' -->
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                                <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
                            </svg>
                        </a>

                        <form action=" {{ path('client.delete', {'id': client.id}) }}" method="post" style="display:inline;">
                               <button type="submit" class="inline-block px-2.5 py-1.5 text-xs font-bold rounded-md  bg-red-100 text-red-800 hover:bg-red-200 transition-colors"
                                        name="_token" value="{{ csrf_token('delete' ~ client.id) }} 
                                        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette recette ?')">
                                                                <!-- Icone 'SUPPRIMER' -->
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                                            <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
                                        </svg>
                                </button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-2 text-center text-sm text-gray-500">Aucun client.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
   
</div>

 {{ knp_pagination_render(clients) }}

{% endblock %}
