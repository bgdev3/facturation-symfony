{% extends 'base.html.twig' %}

{% block title %}Hello ClientController!{% endblock %}

{% block body %}
<h1 class="text-center font-bold text-xl mt-6">Liste clients</h1>
 
<a href=" {{ path('client.create') }}" class="px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark hover:bg-green-100 transition-colors">Ajouter un client</a>
<div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mt-6">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider ">Nom</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Ville</th>
                <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider w-[300px]">Actions</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            {% for client in clients %}
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 text-center whitespace-nowrap text-sm font-medium text-gray-900">{{ client.name }}</td>
                    <td class="px-6 py-4 text-center whitespace-nowrap text-sm text-gray-500">{{ client.email }}</td>
                    <td class="px-6 py-4 text-center whitespace-nowrap text-sm text-gray-500">{{ client.city }}</td>
                    <td class="px-6 py-4 text-center whitespace-nowrap text-right text-sm font-medium">
                        <a href=" {{ path('client.show', {'id':client.id})}}" class="inline-block px-2.5 py-1.5 bg-green-300 text-dark text-xs font-medium rounded-md hover:bg-green-100 transition-colors">Voir</a>
                        <a href=" {{ path('client.edit', {'id':client.id})}}" class="inline-block px-2.5 py-1.5 bg-yellow-300 text-dark text-xs font-medium rounded-md hover:bg-yellow-100 transition-colors">Modifier</a>
                        <form action=" {{ path('client.delete', {'id': client.id}) }}" method="post" style="display:inline;">
                               <button type="submit" class="inline-block px-2.5 py-1.5 bg-red-600 text-white text-xs font-medium rounded-md hover:bg-red-100 transition-colors" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette recette ?')">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-sm text-gray-500">Aucun client.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
   
</div>

 {{ knp_pagination_render(clients) }}


{% endblock %}
