{% extends 'base.html.twig' %}

{% block title %}Hello ClientController!{% endblock %}

{% block body %}

<div class="w-sm mx-auto bg-white rounded-lg shadow border border-gray-200 overflow-hidden mt-6">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
        <h3 class="text-lg text-center font-semibold text-gray-900">{{ client.name }}</h3>
    </div>
    <div class="px-6 py-4">
        <p class="text-sm text-center text-gray-600"><strong>Siret: </strong>{{ client.siret }}</p>
        <p class="text-sm text-center text-gray-600"><strong>Email: </strong>{{ client.email }} </p>
        <p class="text-sm text-center text-gray-600"><strong>Adresse:</strong> {{ client.address}} {{ client.postalCode}} {{ client.city}}</p>
        <p class="text-sm text-center text-gray-600"><strong>Contact:</strong> {{ client.phone }}</p>
    </div>
    <div class="px-6 py-4 border-t border-gray-200 bg-gray-50 flex justify-end gap-2">
        <a href=" {{ path('client.index') }}" class="px-2.5 py-1.5 bg-green-600 mx-auto text-white text-xs font-medium rounded-md hover:bg-green-700">Back</a>
    </div>
</div>

{% endblock %}
