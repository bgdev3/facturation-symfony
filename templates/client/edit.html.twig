{% extends 'base.html.twig' %}

{% block title %}Hello ClientController!{% endblock %}

{% block body %}
<h1 class="text-center text-xl font-bold mb-6 mt-6">Mise à jour</h1>
<div class="max-w-2xl mx-auto">
    {{ form_start(form) }}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {{ form_row(form.name) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.email) }}
            {{ form_row(form.siret) }}
        
            {{ form_row(form.address) }}
            {{ form_row(form.postalCode) }}
            {{ form_row(form.city) }}
        </div>

        <div class="mt-6">
            {{ form_row(form.save) }}
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
