{% extends 'base.html.twig' %}

{% block title %}Devis{% endblock %}

{% block body %}
    <h1>Devis</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ devis.id }}</td>
            </tr>
            <tr>
                <th>Numero</th>
                <td>{{ devis.numero }}</td>
            </tr>
            <tr>
                <th>DateEmission</th>
                <td>{{ devis.dateEmission ? devis.dateEmission|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateValidite</th>
                <td>{{ devis.dateValidite ? devis.dateValidite|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ devis.statut.value }}</td>
            </tr>
            <tr>
                <th>MontantHT</th>
                <td>{{ devis.montantHT }}</td>
            </tr>
            <tr>
                <th>MontantTVA</th>
                <td>{{ devis.montantTVA }}</td>
            </tr>
            <tr>
                <th>MontantTTC</th>
                <td>{{ devis.montantTTC }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('devis.index') }}">back to list</a>

    <a href="{{ path('devis.edit', {'id': devis.id}) }}">edit</a>

   {{ include('devis/_delete_form.html.twig', {'devis': devis}) }}
{% endblock %}
