{% extends 'base.html.twig' %}

{% block title %}Devis{% endblock %}

{% block body %}
    <h1>Devis</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ devi.id }}</td>
            </tr>
            <tr>
                <th>Numero</th>
                <td>{{ devi.numero }}</td>
            </tr>
            <tr>
                <th>DateEmission</th>
                <td>{{ devi.dateEmission ? devi.dateEmission|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DateValidite</th>
                <td>{{ devi.dateValidite ? devi.dateValidite|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Statut</th>
                <td>{{ devi.statut }}</td>
            </tr>
            <tr>
                <th>MontantHT</th>
                <td>{{ devi.montantHT }}</td>
            </tr>
            <tr>
                <th>MontantTVA</th>
                <td>{{ devi.montantTVA }}</td>
            </tr>
            <tr>
                <th>MontantTTC</th>
                <td>{{ devi.montantTTC }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_devis_index') }}">back to list</a>

    <a href="{{ path('app_devis_edit', {'id': devi.id}) }}">edit</a>

    {{ include('devis/_delete_form.html.twig') }}
{% endblock %}
