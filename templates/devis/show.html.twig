{% extends 'base.html.twig' %}

{% block title %}Devis{% endblock %}

{% block body %}
    <h1 class="sr-only text-center font-bold text-2xl">DEVIS</h1>

<div class="max-w-[800px] mx-auto py-12 px-14 bg-white text-text-dark text-sm leading-6 print:py-6 print:px-8">
  <!-- En-tête -->
  <header class="flex justify-between items-start border-b-2 border-text-dark pb-6 mb-8">
    <!-- Émetteur -->
    <div class="emetteur">
      <div class="logo text-xl font-bold text-primary-blue mb-2">{{ app.user.company.logo }}</div>
      <p class="text-xs text-text-medium">
        <strong>{{ app.user.company.name }}</strong><br>
        {{ app.user.company.address }}<br>
        {{ app.user.company.postalCode }} {{ app.user.company.city }}<br>
        SIRET : {{ app.user.company.siret }}
      </p>
    </div>

    <!-- Titre + Infos facture -->
    <div class="titre-bloc text-right">
      <h1 class="text-2xl font-bold tracking-widest mb-4 text-text-dark">DEVIS</h1>
      <table class="infos-facture text-xs ml-auto">
        <tr>
          <td class="text-text-light pr-0">N° facture</td>
          <td class="font-semibold text-text-dark pl-4">{{ devis.numero }}</td>
        </tr>
        <tr>
          <td class="text-text-light pr-0">Date d'émission</td>
          <td class="font-semibold text-text-dark pl-4">{{ devis.dateEmission|date('d/m/Y') }}</td>
        </tr>
        <tr>
          <td class="text-text-light pr-0">Date d'échéance</td>
          <td class="font-semibold text-text-dark pl-4">{{ devis.dateValidite|date('d/m/Y') }}</td>
        </tr>
      </table>
    </div>
  </header>

  <!-- Tableau des lignes -->
  <table class="lignes w-full border-collapse mb-6">
    <thead>
      <tr>
        <th class="col-desc text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Description</th>
        <th class="col-qte text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Qté</th>
        <th class="col-pu text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Prix unitaire HT</th>
        <th class="col-total text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Total</th>
      </tr>
    </thead>
    <tbody>
      {% for ligne in devis.ligneDevis %}
      <tr>
        <td class="py-3 px-3 border-b border-border-light">{{ ligne.designation }}</td>
        <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap">{{ ligne.quantite }}</td>
        <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap">{{ ligne.prixUnitaireHT|number_format(2, ',', ' ') }}&nbsp;€</td>
        <td class="py-3 px-3 border-b border-border-light text-right whitespace-nowrap">{{ (ligne.quantite * ligne.prixUnitaireHT)|number_format(2, ',', ' ') }}&nbsp;€</td>
      </tr>
      {% endfor %}
      <tr>
        <td colspan="4" class="border-b-2 border-text-dark"></td>
      </tr>
    </tbody>
  </table>

  <!-- Totaux -->
  <section class="totaux flex justify-end mb-10">
    <table class="min-w-[260px] border-collapse">
      <tbody>
        <tr>
        
            <td class="py-1.5 text-text-medium">TVA ({{ devis.ligneDevis.first.tauxTVA }}%)</td>
      
          <td class="py-1.5 text-right font-medium">{{ devis.montantTVA|number_format(2, ',', ' ') }}&nbsp;€</td>
        </tr>
        <tr class="total-final">
          <td class="py-2.5 text-text-dark font-bold text-base">Total TTC</td>
          <td class="py-2.5 text-right text-primary-blue font-bold text-xl">{{ devis.montantTTC|number_format(2, ',', ' ') }}&nbsp;€</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- Pied de page -->
  <footer class="facture-footer border-t border-border-light pt-4 text-center">
    <p class="text-xs text-text-lighter mb-1">Ce devis a une durée de validité de 1 mois.</p>
  </footer>
</div>

<div class="max-w-[800px] mx-auto flex justify-between font-bold mb-5">
  
  <a href="{{ path('devis.index') }}" class="inline-block px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark text-xs hover:bg-green-100 transition-colors">
     <!-- icone 'BACK' -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                  <path fill-rule="evenodd" d="M7.793 2.232a.75.75 0 0 1-.025 1.06L3.622 7.25h10.003a5.375 5.375 0 0 1 0 10.75H10.75a.75.75 0 0 1 0-1.5h2.875a3.875 3.875 0 0 0 0-7.75H3.622l4.146 3.957a.75.75 0 0 1-1.036 1.085l-5.5-5.25a.75.75 0 0 1 0-1.085l5.5-5.25a.75.75 0 0 1 1.06.025Z" clip-rule="evenodd" />
            </svg>
  </a>

  {{ include('devis/delete_form.html.twig', {'devis': devis}) }}

 {% if is_granted('DEVIS_EDIT', devis) %}
        <a href="{{ path('devis.edit', {'id': devis.id}) }}" class="inline-block px-2.5 py-1.5 text-center bg-yellow-300 rounded-md text-dark text-xs hover:bg-yellow-100 transition-colors">
           <!-- icone 'MODIFIER' -->
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
                <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
            </svg>
        </a>
                       
  {% endif %}


</div>
{% endblock %}
