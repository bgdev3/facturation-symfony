<div class="max-w-[800px] mx-auto py-12 px-14 bg-white text-text-dark text-sm leading-6">
  {# ... (ton template de facture existant, SANS les liens "edit" et "delete") ... #}
  <header class="flex justify-between items-start border-b-2 border-text-dark pb-6 mb-8">
    <div class="emetteur">
      <div class="logo text-xl font-bold text-primary-blue mb-2">{{ app.user.company.logo }}</div>
      <p class="text-xs text-text-medium">
        <strong>{{ app.user.company.name }}</strong><br>
        {{ app.user.company.address }}<br>
        {{ app.user.company.postalCode }} {{ app.user.company.city }}<br>
        SIRET : {{ app.user.company.siret }}
      </p>
    </div>
    <div class="titre-bloc text-right">
      <h1 class="text-2xl font-bold tracking-widest mb-4 text-text-dark">FACTURE</h1>
      <table class="infos-facture text-xs ml-auto">
        <tr>
          <td class="text-text-dark pr-0">N° facture</td>
          <td class="font-semibold text-text-dark pl-4">{{ devis.numero }}</td>
        </tr>
        <tr>
          <td class="text-text-dark pr-0">Date d'émission</td>
          <td class="font-semibold text-text-dark pl-4">{{ devis.dateEmission|date('d/m/Y') }}</td>
        </tr>
        <tr>
          <td class="text-text-dark pr-0">Date d'échéance</td>
          <td class="font-semibold text-text-dark pl-4">{{ devis.dateValidite|date('d/m/Y') }}</td>
        </tr>
      </table>
    </div>
  </header>

  {# Tableau des lignes #}
  <table class="lignes w-full border-collapse mb-6">
    <thead>
      <tr>
        <th class="text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Description</th>
        <th class="text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Qté</th>
        <th class="text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Prix unitaire HT</th>
        <th class="text-center text-xs uppercase tracking-wider text-dark bg-text-dark py-2.5 px-3">Total</th>
      </tr>
    </thead>
    <tbody>
      {% for ligne in devis.ligneDevis %}
      <tr>
        <td class="py-3 px-3 border-b border-border-light">{{ ligne.designation }}</td>
        <td class="py-3 px-3 border-b border-border-light text-right">{{ ligne.quantite }}</td>
        <td class="py-3 px-3 border-b border-border-light text-right">{{ ligne.prixUnitaireHT|number_format(2, ',', ' ') }} €</td>
        <td class="py-3 px-3 border-b border-border-light text-right">{{ (ligne.quantite * ligne.prixUnitaireHT)|number_format(2, ',', ' ') }} €</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {# Totaux #}
  <section class="totaux flex justify-end mb-10">
    <table class="min-w-[260px] border-collapse">
      <tbody>
        <tr>
          <td class="py-1.5 text-text-medium">TVA ({{ devis.ligneDevis.first.tauxTVA }}%)</td>
          <td class="py-1.5 text-right font-medium">{{ devis.montantTVA|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr class="total-final">
          <td class="py-2.5 text-text-dark font-bold text-base">Total TTC</td>
          <td class="py-2.5 text-right text-primary-blue font-bold text-xl">{{ devis.montantTTC|number_format(2, ',', ' ') }} €</td>
        </tr>
      </tbody>
    </table>
  </section>
</div>