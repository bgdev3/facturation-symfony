
  {{ form_start(form) }}
<div class="flex flex-col lg:flex-row gap-4">
    <div   class="w-full lg:w-1/3 bg-white p-4 rounded-lg shadow-md overflow-auto max-h-[calc(100vh-200px)]">

  
        {{ form_row(form.numero) }}
        {{ form_row(form.dateEmission) }}
        {{ form_row(form.dateValidite) }}
        {{ form_row(form.statut) }}
        <div class="hidden">
 {{ form_row(form.montantHT) }}
        {{ form_row(form.montantTVA) }}
        {{ form_row(form.montantTTC) }}
        </div>
       
        {{ form_row(form.client) }}
    
    </div>

    <div data-controller="ligne-devis" 
         data-ligne-devis-index-value="{{ form.ligneDevis|length }}"
         class="w-full lg:w-2/3 bg-white p-4 rounded-lg shadow-md overflow-auto max-h-[calc(100vh-200px)]">

        {% set removeButtonHtml %}
        <div class="flex justify-center">
             <button type="button" data-action="ligne-devis#remove" class="flex items-center justify-center  px-2.5 py-1.5 text-center bg-red-300 rounded-md text-dark text-xs hover:bg-red-100 transition-colors">Supprimer</button>
        </div>
           
        {% endset %}

        <div data-ligne-devis-target="list"
            data-prototype="{{ form_widget(form.ligneDevis.vars.prototype)|e('html_attr') }}"
            data-remove-button="{{ removeButtonHtml|e('html_attr') }}">
            
            {% for ligneDevisForm in form.ligneDevis %}
                <div class="ligne-devis-item flex items-center justify-between gap-3">
                    <div class="flex-1">
                        {{ form_widget(ligneDevisForm) }}
                    </div>
                    <button type="button" data-action="ligne-devis#remove" class="flex items-center justify-center  px-2.5 py-1.5 text-center bg-red-300 rounded-md text-dark text-xs hover:bg-red-100 transition-colors">Supprimer</button>
                </div>
            {% endfor %}
        </div>

        <div class="flex justify-center items-center mt-2 mb-2">
            <button type="button" data-action="ligne-devis#add" class="flex items-center justify-center px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark text-xs hover:bg-green-100 transition-colors">Ajouter une dénomination</button>
        </div>
    </div>

    
</div>
<div class="w-full flex justify-center">
     {{ form_row(form.save) }}
</div>
    {{ form_end(form) }}