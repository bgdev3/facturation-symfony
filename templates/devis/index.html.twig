{% extends 'base.html.twig' %}

{% block title %}Devis index{% endblock %}

{% block body %}
    <h1 class="text-center font-bold text-xl mt-6">Liste devis</h1>
    <a href="{{ path('devis.create') }}" class="px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark hover:bg-green-100 transition-colors">Nouveau devis</a>
<div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mt-6"></div>
    <table class="min-w-full divide-y divide-gray-200">
        <thead>
            
                {% set colonnes = [
                'Id',
                'Numero',
                'DateEmission',
                'DateValidite',
                'Statut',
                'MontantHT',
                'MontantTVA',
                'MontantTTC',
                'actions'
                ] %}

            <tr>
                {% for colonne in colonnes %}
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">
                        {{ colonne }}
                    </th>
                {% endfor %}
            </tr>

        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
        {% for devis in devis %}
            <tr>
                <td>{{ devis.id }}</td>
                <td>{{ devis.numero }}</td>
                <td>{{ devis.dateEmission ? devis.dateEmission|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ devis.dateValidite ? devis.dateValidite|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ devis.statut.value }}</td>
                <td>{{ devis.montantHT }}</td>
                <td>{{ devis.montantTVA }}</td>
                <td>{{ devis.montantTTC }}</td>
                <td>
                    <a href="{{ path('devis.show', {'id': devis.id}) }}">show</a>
                    <a href="{{ path('devis.edit', {'id': devis.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr class="text-center">
                <td colspan="9">Auncun devis trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
 
{% endblock %}
