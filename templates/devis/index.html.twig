{% extends 'base.html.twig' %}

{% block title %}Devis index{% endblock %}

{% block body %}
    <h1 class="text-center font-bold text-xl mt-6">Liste devis</h1>
    <a href="{{ path('devis.create') }}" class="px-2.5 py-1.5 text-center bg-green-300 rounded-md text-dark hover:bg-green-100 transition-colors">Nouveau devis</a>
<div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm mt-6"></div>
    <table class="min-w-full divide-y divide-gray-200">
        <thead>
            
                {% set colonnes = [
                'Id',
                'Numero',
                'Date Emission',
                'Date Validite',
                'MontantHT',
                'MontantTVA',
                'MontantTTC',
                 'Statut',
                'actions'
                ] %}

            <tr>
                {% for colonne in colonnes %}
                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider ">
                        {{ colonne }}
                    </th>
                {% endfor %}
            </tr>

        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
        {% for devis in devis %}

            {% set colonnes = [
                 devis.id,
                 devis.numero ,
                 devis.dateEmission ? devis.dateEmission|date('Y-m-d H:i:s') : '' ,
                 devis.dateValidite ? devis.dateValidite|date('Y-m-d H:i:s') : '' ,
                 devis.montantHT ,
                 devis.montantTVA, 
                 devis.montantTTC,  ]
            %}
            <tr class="hover:bg-gray-50 ">
                {% for colonne in colonnes %}
                    <th class="px-6 py-2 text-center whitespace-nowrap text-sm font-medium text-gray-900 ">
                        {{ colonne }}
                    </th>
                {% endfor %}

                 <th class="px-6 py-2 text-center whitespace-nowrap text-sm font-bold uppercase text-gray-900">
                {{ include('components/badge_statut.html.twig', { statut: devis.statut }) }}
            </th>
                <th class="px-1 py-1 text-center whitespace-nowrap text-sm font-medium text-gray-900">
                    <a href="{{ path('devis.show', {'id': devis.id}) }}" class="inline-block px-2.5 py-1.5 bg-green-300 font-bold text-dark text-xs  rounded-md hover:bg-green-100 transition-colors">Voir</a>
                    <a href="{{ path('devis.edit', {'id': devis.id}) }}" class="inline-block px-2.5 py-1.5 bg-yellow-300 font-bold text-dark text-xs  rounded-md hover:bg-yellow-100 transition-colors">Modifier</a>
                    <form action=" {{ path('devis.delete', {'id': devis.id}) }}" method="post" style="display:inline;">
                            <button type="submit" class="inline-block px-2.5 py-1.5 bg-red-300 text-dark text-xs font-bold rounded-md hover:bg-red-100 transition-colors"
                                    name="_token" value="{{ csrf_token('delete' ~ devis.id) }} 
                                    onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette recette ?')">Supprimer</button>
                    </form>
                </th>
            </tr>
           
        {% else %}
            <tr class="text-center">
                <td colspan="9">Auncun devis trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
 
{% endblock %}
