<form method="post" action="{{ path('devis.delete', {'id': devis.id}) }}" onsubmit="return confirm('Supprimer ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devis.id) }}">
    <button class="inline-block px-2.5 py-1.5 text-center bg-red-300 rounded-md text-dark text-xs hover:bg-red-100 transition-colors">Supprimer</button>
</form>
